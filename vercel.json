{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/v3", "destination": "/", "permanent": true },
    { "source": "/v3/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/projects/:slug", "destination": "/project/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
